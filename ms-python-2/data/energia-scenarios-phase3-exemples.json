{
  "metadata": {
    "project": "EnergIA",
    "dataset": "phase3_consumption_event_examples",
    "description": "Ready-to-use examples showing a simple expected format for temporary regional consumption variations.",
    "values_are_simulated": true,
    "event_semantics": "Events apply from start inclusive to end exclusive. Simultaneous events are cumulative."
  },
  "event_schema_examples": {
    "absolute_delta": {
      "type": "consumption_delta",
      "region_id": "occitanie",
      "start": "17:30",
      "end": "21:00",
      "delta_mw": 850
    },
    "percentage_delta": {
      "type": "consumption_delta",
      "region_id": "grand_est",
      "start": "10:00",
      "end": "12:30",
      "delta_percent": -12
    }
  },
  "scenarios": [
